# flop-automation-kit — environment template.
# Copy to .env and fill in values. NEVER commit a real .env.
# All values below are placeholders or devnet defaults.

# --- Official FLOP endpoints (devnet-verified 2026-11-24) ---
# The real testnet has NOT opened yet (Draft, Q4 2026). When it opens,
# point these at the published testnet URLs.
FLOP_FAUCET_URL=https://faucet.flop.network
FLOP_RPC_URL=https://rpc.devnet.flop.network
FLOP_GATEWAY_URL=https://api.flop.network

# Client identifier sent with faucet claims (verified working value).
FLOP_FAUCET_CLIENT=flop-llms-txt

# --- Chain identity (devnet) ---
FLOP_CHAIN_SS58=42
FLOP_CHAIN_GENESIS=0x99c172c095340ace980631f9123544c6bebd4839f3437e463533422d8be2d631
FLOP_CHAIN_DECIMALS=18
FLOP_CHAIN_SYMBOL=FLOP

# --- Local storage ---
FLOP_KEYSTORE_DIR=./keystore
FLOP_DATA_DIR=./data
# FLOP_GATEWAY_KEY_FILE=./keystore/gateway.key
# FLOP_TRACKER_DB=./data/activity.db

# --- Keystore password (preferred: enter it interactively instead) ---
# FLOP_KEYSTORE_PASSWORD=change-me-to-a-long-random-password

# --- Gateway API key (alternative to the key file; prefer the file) ---
# FLOP_GATEWAY_KEY=

# --- HTTP behaviour ---
FLOP_HTTP_TIMEOUT_MS=30000
FLOP_INFERENCE_TIMEOUT_MS=300000
FLOP_MAX_RETRIES=4
FLOP_RETRY_BASE_MS=1000
FLOP_MIN_REQUEST_INTERVAL_MS=500
FLOP_MAX_RETRY_AFTER_MS=120000

# --- Hermes provider (optional; leave empty = not configured) ---
# FLOP_HERMES_ENDPOINT=
# FLOP_HERMES_BINARY=
# FLOP_HERMES_CONFIG=./hermes.config.json

FLOP_LOG_LEVEL=info
